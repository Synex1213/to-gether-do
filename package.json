{
  "name": "couple-widget",
  "version": "1.0.0",
  "description": "伙伴打卡桌面悬浮小窗",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.couple.widget",
    "productName": "伙伴打卡",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "widget/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
